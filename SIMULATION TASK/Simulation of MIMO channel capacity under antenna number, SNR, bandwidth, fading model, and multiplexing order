clc;
clear;
close all;

%% MIMO Channel Capacity Simulation
% Capacity = B*log2(det(I + (SNR/Nt)*H*H'))

%% Basic Parameters
Nt = 4;                         % Number of Transmit antennas
Nr = 4;                         % Number of Receive antennas
SNR_dB = 0:5:30;               % SNR range
B = 10e6;                       % Bandwidth = 10 MHz
numRealizations = 100;          % Channel realizations

%% ---------------------------------------------------------
% 1. Capacity vs SNR
%% ---------------------------------------------------------

capacity_snr = zeros(size(SNR_dB));

for k = 1:length(SNR_dB)

    snr = 10^(SNR_dB(k)/10);
    cap = 0;

    for n = 1:numRealizations

        % Rayleigh fading channel
        H = (randn(Nr,Nt) + 1i*randn(Nr,Nt))/sqrt(2);

        % MIMO Capacity
        cap = cap + B * real(log2(det( ...
            eye(Nr) + (snr/Nt)*(H*H'))));
    end

    capacity_snr(k) = cap/numRealizations/1e6;
end

figure;
plot(SNR_dB,capacity_snr,'o-','LineWidth',2);
grid on;
xlabel('SNR (dB)');
ylabel('Capacity (Mbps)');
title('MIMO Capacity vs SNR');


%% ---------------------------------------------------------
% 2. Capacity vs Number of Antennas
%% ---------------------------------------------------------

antenna_values = 1:6;
capacity_ant = zeros(size(antenna_values));

snr = 10^(20/10);              % SNR = 20 dB

for a = 1:length(antenna_values)

    N = antenna_values(a);
    cap = 0;

    for n = 1:numRealizations

        H = (randn(N,N) + 1i*randn(N,N))/sqrt(2);

        cap = cap + B * real(log2(det( ...
            eye(N) + (snr/N)*(H*H'))));
    end

    capacity_ant(a) = cap/numRealizations/1e6;
end

figure;
plot(antenna_values,capacity_ant,'s-','LineWidth',2);
grid on;
xlabel('Number of Transmit/Receive Antennas');
ylabel('Capacity (Mbps)');
title('MIMO Capacity vs Number of Antennas');


%% ---------------------------------------------------------
% 3. Capacity vs Bandwidth
%% ---------------------------------------------------------

bandwidth_values = [1 5 10 20 50]*1e6;
capacity_bw = zeros(size(bandwidth_values));

snr = 10^(20/10);

H = (randn(Nr,Nt) + 1i*randn(Nr,Nt))/sqrt(2);

for k = 1:length(bandwidth_values)

    capacity_bw(k) = bandwidth_values(k) * ...
        real(log2(det(eye(Nr) + ...
        (snr/Nt)*(H*H'))))/1e6;
end

figure;
plot(bandwidth_values/1e6,capacity_bw,'d-','LineWidth',2);
grid on;
xlabel('Bandwidth (MHz)');
ylabel('Capacity (Mbps)');
title('MIMO Capacity vs Bandwidth');


%% ---------------------------------------------------------
% 4. Capacity under Different Fading Models
%% ---------------------------------------------------------

fading_models = {'AWGN','Rayleigh','Rician'};
capacity_fading = zeros(1,3);

snr = 10^(20/10);

% AWGN channel
H = eye(Nr,Nt);
capacity_fading(1) = B * real(log2(det( ...
    eye(Nr)+(snr/Nt)*(H*H'))))/1e6;

% Rayleigh channel
cap = 0;

for n = 1:numRealizations
    H = (randn(Nr,Nt)+1i*randn(Nr,Nt))/sqrt(2);

    cap = cap + B*real(log2(det( ...
        eye(Nr)+(snr/Nt)*(H*H'))));
end

capacity_fading(2) = cap/numRealizations/1e6;

% Rician channel
K = 5;                         % Rician K-factor
cap = 0;

for n = 1:numRealizations

    H_los = ones(Nr,Nt);
    H_nlos = (randn(Nr,Nt)+1i*randn(Nr,Nt))/sqrt(2);

    H = sqrt(K/(K+1))*H_los + ...
        sqrt(1/(K+1))*H_nlos;

    cap = cap + B*real(log2(det( ...
        eye(Nr)+(snr/Nt)*(H*H'))));
end

capacity_fading(3) = cap/numRealizations/1e6;

figure;
bar(capacity_fading);
grid on;
set(gca,'XTickLabel',fading_models);
xlabel('Fading Model');
ylabel('Capacity (Mbps)');
title('MIMO Capacity for Different Fading Models');


%% ---------------------------------------------------------
% 5. Capacity vs Multiplexing Order
%% ---------------------------------------------------------

multiplexing_order = 1:min(Nt,Nr);
capacity_mux = zeros(size(multiplexing_order));

snr = 10^(20/10);

for r = 1:length(multiplexing_order)

    cap = 0;

    for n = 1:numRealizations

        H = (randn(Nr,Nt)+1i*randn(Nr,Nt))/sqrt(2);

        % Singular values
        singular_values = svd(H);

        % Use first r spatial streams
        lambda = singular_values(1:r).^2;

        cap_temp = 0;

        for m = 1:r
            cap_temp = cap_temp + ...
                log2(1+(snr/Nt)*lambda(m));
        end

        cap = cap + B*cap_temp;
    end

    capacity_mux(r) = cap/numRealizations/1e6;
end

figure;
plot(multiplexing_order,capacity_mux,'^-','LineWidth',2);
grid on;
xlabel('Multiplexing Order');
ylabel('Capacity (Mbps)');
title('MIMO Capacity vs Multiplexing Order');


%% ---------------------------------------------------------
% Display Results
%% ---------------------------------------------------------

fprintf('\n============================================\n');
fprintf('       MIMO CAPACITY SIMULATION RESULTS\n');
fprintf('============================================\n');

fprintf('\nCapacity at SNR = 20 dB: %.2f Mbps\n', ...
    capacity_snr(SNR_dB == 20));

fprintf('Capacity with %d antennas: %.2f Mbps\n', ...
    Nt,capacity_ant(Nt));

fprintf('Capacity at 10 MHz bandwidth: %.2f Mbps\n', ...
    capacity_bw(bandwidth_values == 10e6));

fprintf('\nFading Model Capacities:\n');
fprintf('AWGN     : %.2f Mbps\n',capacity_fading(1));
fprintf('Rayleigh : %.2f Mbps\n',capacity_fading(2));
fprintf('Rician   : %.2f Mbps\n',capacity_fading(3));

fprintf('\nMultiplexing Order Results:\n');

for r = 1:length(multiplexing_order)
    fprintf('Order %d : %.2f Mbps\n', ...
        multiplexing_order(r),capacity_mux(r));
end

fprintf('\nSimulation Completed Successfully.\n');
