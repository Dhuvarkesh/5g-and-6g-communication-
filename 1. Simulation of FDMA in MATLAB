% New MATLAB Script

clc; clear; close all;

% Parameters
TBW = 600; Users = 3; BW = 200; M = 2;
fs = 1000; t = 0:1/fs:1;
fc = [100 300 500];

% FDMA Signal Generation
m = sin(2*pi*10*t);
s = [m.*cos(2*pi*fc(1)*t);
     m.*cos(2*pi*fc(2)*t);
     m.*cos(2*pi*fc(3)*t)];

% Data Rate
CBW = TBW/Users;
DataRate = BW*log2(M);
Rate = DataRate*ones(1,Users);

% SNR
Ps = 1;
Pn = [0.1 0.05 0.01];
SNR = 10*log10(Ps./Pn);

% Display Results
disp('User   Bandwidth(kHz)   DataRate(kbps)   Noise(W)   SNR(dB)');
disp([(1:Users)' CBW*ones(Users,1) Rate' Pn' SNR']);

% Plots
figure;

subplot(3,1,1);
plot(t,s(1,:),t,s(2,:),t,s(3,:)); grid on;
title('FDMA Channel Allocation');
xlabel('Time (s)'); ylabel('Amplitude');
legend('User 1','User 2','User 3');

subplot(3,1,2);
bar(1:Users,Rate); grid on;
xlabel('Users'); ylabel('Data Rate (kbps)');
title('FDMA Data Rate per User');

subplot(3,1,3);
bar(1:Users,SNR); grid on;
xlabel('Users'); ylabel('SNR (dB)');
title('SNR of FDMA Users');
